<header class="navbar" id="main-navbar">
  <div class="navbar-inner">
   
    <a href="/" class="navbar-brand">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <path d="M11.47 3.84a.75.75 0 011.06 0l8.69 8.69a.75.75 0 101.06-1.06l-8.689-8.69a2.25 2.25 0 00-3.182 0l-8.69 8.69a.75.75 0 001.061 1.06l8.69-8.69z"/>
        <path d="M12 5.432l8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 01-.75-.75v-4.5a.75.75 0 00-.75-.75h-3a.75.75 0 00-.75.75V21a.75.75 0 01-.75.75H5.625a1.875 1.875 0 01-1.875-1.875v-6.198a2.29 2.29 0 00.091-.086L12 5.43z"/>
      </svg>
      <span>Zoriva</span>
    </a>

    <ul class="nav-links desktop-nav">
      <li>
        <a href="/" class="nav-link <%= currentPage === 'index' ? 'active' : '' %>">
          <i class="fas fa-compass"></i>
          <span>Explore</span>
        </a>
      </li>

      <% if (isLoggedIn) { %>
        <% if (user && user.userType === 'guest') { %>
          <li>
            <a href="/homes" class="nav-link <%= currentPage === 'Home' ? 'active' : '' %>">
              <i class="fas fa-home"></i>
              <span>Homes</span>
            </a>
          </li>
          <li>
            <a href="/favourites" class="nav-link <%= currentPage === 'favourites' ? 'active' : '' %>">
              <i class="fas fa-heart"></i>
              <span>Favourites</span>
            </a>
          </li>
          <li>
            <a href="/bookings" class="nav-link <%= currentPage === 'bookings' ? 'active' : '' %>">
              <i class="fas fa-calendar-check"></i>
              <span>Bookings</span>
            </a>
          </li>
        <% } else { %>
          <li>
            <a href="/host/host-home-list" class="nav-link <%= currentPage === 'host-homes' ? 'active' : '' %>">
              <i class="fas fa-building"></i>
              <span>Host Homes</span>
            </a>
          </li>
          <li>
            <a href="/host/bookings" class="nav-link <%= currentPage === 'host-bookings' ? 'active' : '' %>">
              <i class="fas fa-calendar-check"></i>
              <span>Bookings</span>
            </a>
          </li>
          <li>
            <a href="/host/add-home" class="nav-link <%= currentPage === 'addHome' ? 'active' : '' %>">
              <i class="fas fa-plus-circle"></i>
              <span>Add Home</span>
            </a>
          </li>
        <% } %>
      <% } %>
    </ul>

    <ul class="nav-actions desktop-actions">
      <% if (!isLoggedIn) { %>
        <li>
          <a href="/signup" class="btn btn-ghost btn-sm">Sign Up</a>
        </li>
        <li>
          <a href="/login" class="btn btn-primary btn-sm">Log In</a>
        </li>
      <% } else { %>
        <li class="user-chip">
          <div class="user-badge">
            <i class="fas fa-user-circle"></i>
            <span><%= (user && user.firstName) ? user.firstName : (user && user.userType === 'guest' ? 'Guest' : 'Host') %></span>
            <span class="user-role-pill <%= (user && user.userType === 'guest') ? 'role-guest' : 'role-host' %>"><%= (user && user.userType) ? user.userType : 'user' %></span>
          </div>
        </li>
        <li>
          <form action="/logout" method="POST" style="margin:0;">
            <button type="submit" class="btn btn-ghost btn-sm">
              <i class="fas fa-sign-out-alt"></i>
              <span>Logout</span>
            </button>
          </form>
        </li>
      <% } %>
    </ul>

    <!-- Mobile Toggle -->
    <button class="mobile-toggle" id="mobile-menu-button" aria-label="Toggle navigation">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
      </svg>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <ul class="nav-links">
      <li>
        <a href="/" class="nav-link <%= currentPage === 'index' ? 'active' : '' %>">
          <i class="fas fa-compass"></i>
          <span>Explore</span>
        </a>
      </li>
      <% if (isLoggedIn) { %>
        <% if (user && user.userType === 'guest') { %>
          <li>
            <a href="/homes" class="nav-link <%= currentPage === 'Home' ? 'active' : '' %>">
              <i class="fas fa-home"></i>
              <span>Homes-List</span>
            </a>
          </li>
          <li>
            <a href="/favourites" class="nav-link <%= currentPage === 'favourites' ? 'active' : '' %>">
              <i class="fas fa-heart"></i>
              <span>Favourites</span>
            </a>
          </li>
          <li>
            <a href="/bookings" class="nav-link <%= currentPage === 'bookings' ? 'active' : '' %>">
              <i class="fas fa-calendar-check"></i>
              <span>Bookings</span>
            </a>
          </li>
        <% } else { %>
          <li>
            <a href="/host/host-home-list" class="nav-link <%= currentPage === 'host-homes' ? 'active' : '' %>">
              <i class="fas fa-building"></i>
              <span>Host Homes</span>
            </a>
          </li>
          <li>
            <a href="/host/bookings" class="nav-link <%= currentPage === 'host-bookings' ? 'active' : '' %>">
              <i class="fas fa-calendar-check"></i>
              <span>Bookings</span>
            </a>
          </li>
          <li>
            <a href="/host/add-home" class="nav-link <%= currentPage === 'addHome' ? 'active' : '' %>">
              <i class="fas fa-plus-circle"></i>
              <span>Add Home</span>
            </a>
          </li>
        <% } %>
      <% } %>
    </ul>

    <ul class="nav-actions">
      <% if (!isLoggedIn) { %>
        <li><a href="/signup" class="btn btn-ghost">Sign Up</a></li>
        <li><a href="/login" class="btn btn-primary">Log In</a></li>
      <% } else { %>
        <li>
          <form action="/logout" method="POST" style="margin:0; width:100%;">
            <button type="submit" class="btn btn-ghost" style="width:100%;">
              <i class="fas fa-sign-out-alt"></i>
              <span>Logout (<%= (user && user.firstName) ? user.firstName : 'Account' %>)</span>
            </button>
          </form>
        </li>
      <% } %>
    </ul>
  </div>
</header>

<script>
  document.getElementById("mobile-menu-button")?.addEventListener("click", function() {
    document.getElementById("mobile-menu")?.classList.toggle("open");
  });
</script>

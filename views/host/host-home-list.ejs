<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>

    <main class="page-main">
      <div class="section-headline" style="margin-bottom: 32px;">
        <div>
          <h2>Your Hosted Properties</h2>
          <p class="section-subtext">Manage, edit, and keep track of your active listings</p>
        </div>
        <div>
          <a href="/host/add-home" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i> Add New Property
          </a>
        </div>
      </div>

      <% if (registeredHomes.length > 0) { %>
        <div class="card-grid">
          <% registeredHomes.forEach(home => { %>
            <div class="card">
              <div class="card-image-wrapper">
                <img 
                  src="<%= getPhotoUrl(home.photo) %>" 
                  alt="<%= home.houseName || 'Property image' %>"
                  loading="lazy"
                >
                <div class="card-image-overlay"></div>
                
                <div class="card-glass-rating">
                  <i class="fas fa-star" style="color: #FFB703;"></i>
                  <span><%= home.rating ? home.rating : '5.0' %></span>
                </div>
              </div>

              <div class="card-body">
                <h3 class="card-title"><%= home.houseName %></h3>
                <p class="card-location">
                  <i class="fas fa-map-marker-alt"></i>
                  <%= home.location %>
                </p>

                <div class="card-footer">
                  <div class="card-price">
                    <span class="price-currency">₹</span>
                    <span class="price-amount"><%= Number(home.price).toLocaleString('en-IN') %></span>
                    <span class="price-period">/ night</span>
                  </div>

                  <div style="display:flex; gap:8px;">
                    <a href="/host/edit-home/<%= home._id %>?editing=true" class="btn btn-ghost btn-sm" title="Edit">
                      <i class="fas fa-pen"></i> Edit
                    </a>
                    <form action="/host/delete-home/<%= home._id %>" method="POST" style="margin:0;">
                      <button type="submit" class="btn btn-danger btn-sm" title="Delete" onclick="return confirm('Are you sure you want to delete this listing?');">
                        <i class="fas fa-trash-alt"></i>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-state-icon">
            <i class="fas fa-building"></i>
          </div>
          <h2>No Properties Listed</h2>
          <p>You haven't added any listings yet. Start earning by hosting guests.</p>
          <a href="/host/add-home" class="btn btn-primary" style="margin-top: 18px;">
            <i class="fas fa-plus"></i> Add Your First Property
          </a>
        </div>
      <% } %>
    </main>
  </body>
</html>

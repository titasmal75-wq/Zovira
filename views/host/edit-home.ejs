<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>

    <main class="page-main">
      <div class="form-container">
        <div class="form-header">
          <h1><%= editing ? "Edit" : "List" %> Your <span class="text-gradient">Home</span></h1>
          <p><%= editing ? "Update your listing details" : "Share your space with the world" %></p>
        </div>

        <form action="/host/<%= editing ? 'edit-home' : 'add-home' %>" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="id" value="<%= editing ? home._id : '' %>">

          <!-- House Name -->
          <div class="form-group">
            <label for="houseName" class="form-label">House Name</label>
            <div class="form-input-wrapper">
              <input
                type="text"
                id="houseName"
                name="houseName"
                value="<%= editing ? home.houseName : '' %>"
                placeholder="e.g. Cozy Mountain Retreat"
                class="form-input"
                required
              />
              <i class="fas fa-home form-input-icon"></i>
            </div>
          </div>

          <!-- Price -->
          <div class="form-group">
            <label for="price" class="form-label">Price Per Night (₹)</label>
            <div class="form-input-wrapper">
              <input
                type="number"
                id="price"
                name="price"
                value="<%= editing ? home.price : '' %>"
                placeholder="e.g. 2500"
                class="form-input"
                required
              />
              <i class="fas fa-rupee-sign form-input-icon"></i>
            </div>
          </div>

          <div class="form-group">
            <label for="maxGuests" class="form-label">Maximum Guests</label>
            <div class="form-input-wrapper">
              <input
                type="number"
                id="maxGuests"
                name="maxGuests"
                value="<%= editing ? (home.maxGuests || 20) : 1 %>"
                min="1"
                max="20"
                class="form-input"
                required
              />
              <i class="fas fa-users form-input-icon"></i>
            </div>
          </div>

          <!-- Location -->
          <div class="form-group">
            <label for="location" class="form-label">Location</label>
            <div class="form-input-wrapper">
              <input
                type="text"
                id="location"
                name="location"
                value="<%= editing ? home.location : '' %>"
                placeholder="e.g. Manali, Himachal Pradesh"
                class="form-input"
                required
              />
              <i class="fas fa-map-marker-alt form-input-icon"></i>
            </div>
          </div>

          <!-- Rating -->
          <div class="form-group">
            <label for="rating" class="form-label">Rating (1-5)</label>
            <div class="form-input-wrapper">
              <input
                type="number"
                step="0.1"
                min="1"
                max="5"
                id="rating"
                name="rating"
                value="<%= editing ? home.rating : '' %>"
                placeholder="e.g. 4.5"
                class="form-input"
                required
              />
              <i class="fas fa-star form-input-icon"></i>
            </div>
          </div>

          <!-- Photo Upload & Live Preview -->
          <div class="form-group">
            <label for="photo" class="form-label">
              <%= editing ? "Property Photo (Choose new to update)" : "Upload Property Photo" %>
            </label>
            <div class="form-input-wrapper">
              <input
                type="file"
                id="photo"
                name="photo"
                accept="image/png, image/jpeg, image/jpg"
                class="form-input"
                <%= editing ? '' : 'required' %>
              />
              <i class="fas fa-image form-input-icon"></i>
            </div>
            <% if (editing) { %>
              <p style="font-size: 0.8rem; color: var(--text-dim); margin-top: 6px;">
                <i class="fas fa-info-circle"></i> Leave empty to keep the existing photo, or select a new file to change it.
              </p>
            <% } %>

            <!-- Preview Card -->
            <% const hasExistingPhoto = editing && home && home.photo; %>
            <div id="image-preview-container" style="<%= hasExistingPhoto ? 'margin-top: 14px;' : 'display: none; margin-top: 14px;' %>">
              <div style="font-size: 0.82rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 8px;" id="preview-title">
                <%= hasExistingPhoto ? "Current Property Photo:" : "Image Preview:" %>
              </div>
              <div style="position: relative; width: 100%; border-radius: 12px; overflow: hidden; border: 1px solid var(--glass-border); background: #13151b;">
                <img
                  id="image-preview"
                  src="<%= hasExistingPhoto ? getPhotoUrl(home.photo) : '' %>"
                  alt="Property Preview"
                  style="width: 100%; height: 210px; object-fit: cover; display: block;"
                />
                <span id="preview-badge" style="position: absolute; top: 12px; right: 12px; background: rgba(0, 0, 0, 0.7); color: #fff; font-size: 0.75rem; font-weight: 600; padding: 4px 10px; border-radius: 20px; backdrop-filter: blur(6px); border: 1px solid rgba(255, 255, 255, 0.15);">
                  <%= hasExistingPhoto ? "Current Photo" : "New Photo" %>
                </span>
              </div>
            </div>
          </div>

          <!-- Description -->
          <div class="form-group">
            <label for="description" class="form-label">Description</label>
            <div class="form-input-wrapper">
              <input
                type="text"
                id="description"
                name="description"
                value="<%= editing ? home.description : '' %>"
                placeholder="Describe your amazing space..."
                class="form-input"
              />
              <i class="fas fa-align-left form-input-icon"></i>
            </div>
          </div>

          <!-- Submit -->
          <button type="submit" class="form-submit">
            <i class="fas fa-<%= editing ? 'save' : 'plus-circle' %>"></i>
            <span><%= editing ? "Update Home" : "Add Home" %></span>
          </button>
        </form>
      </div>
    </main>

    <script>
      const photoInput = document.getElementById('photo');
      const previewContainer = document.getElementById('image-preview-container');
      const previewImg = document.getElementById('image-preview');
      const previewTitle = document.getElementById('preview-title');
      const previewBadge = document.getElementById('preview-badge');

      if (photoInput) {
        photoInput.addEventListener('change', function(event) {
          const file = event.target.files && event.target.files[0];
          if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
              previewImg.src = e.target.result;
              previewContainer.style.display = 'block';
              if (previewTitle) {
                previewTitle.textContent = 'Selected New Photo Preview:';
              }
              if (previewBadge) {
                previewBadge.textContent = 'New Photo Selected';
                previewBadge.style.background = 'rgba(255, 56, 92, 0.85)';
              }
            };
            reader.readAsDataURL(file);
          }
        });
      }
    </script>
  </body>
</html>
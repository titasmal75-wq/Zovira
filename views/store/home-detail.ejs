<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>

    <main class="page-main">
      <div class="page-header">
        <h1 class="page-title"><span class="page-title-accent"><%= home.houseName || home.name %></span></h1>
        <p class="page-subtitle"><i class="fas fa-map-marker-alt" style="color: var(--brand-pink);"></i> <%= home.location %></p>
      </div>

      <% if (locals.flashSuccess) { %>
        <div class="booking-alert booking-alert-success" style="max-width: 800px; margin: 0 auto 24px;">
          <i class="fas fa-check-circle"></i> <%= flashSuccess %>
        </div>
      <% } %>

      <% if (locals.flashError) { %>
        <div class="booking-alert booking-alert-error" style="max-width: 800px; margin: 0 auto 24px;">
          <i class="fas fa-exclamation-circle"></i> <%= flashError %>
        </div>
      <% } %>

      <div class="detail-layout">
        <div class="detail-image">
          <img 
            src="<%= getPhotoUrl(home.photo) %>" 
            alt="<%= home.houseName || home.name || 'Property image' %>"
          >
        </div>

        <div class="detail-info">
          <div class="detail-section">
            <h3>Description</h3>
            <p><%= home.description || 'A beautiful and cozy space perfect for your next getaway.' %></p>
          </div>

          <div class="detail-section">
            <h3>Location</h3>
            <div class="detail-value" style="display:flex; align-items:center; gap:8px;">
              <i class="fas fa-map-marker-alt" style="color: var(--brand-pink);"></i>
              <%= home.location %>
            </div>
          </div>

          <div class="detail-section">
            <h3>Price Per Night</h3>
            <div class="detail-price-tag">
              ₹<%= home.price %> <span>/ night</span>
            </div>
          </div>

          <div class="detail-section">
            <h3>Maximum Guests</h3>
            <div class="detail-value"><i class="fas fa-user-friends" style="color: var(--brand-pink); margin-right: 6px;"></i> <%= home.maxGuests || 20 %> guests</div>
          </div>

          <div class="detail-section">
            <h3>Guest Rating</h3>
            <div class="detail-rating-display">
              <% const numericAvg = Number(averageRating) || 5; %>
              <% for (let i = 1; i <= 5; i++) { %>
                <span class="star">
                  <i class="fas fa-star" style="color: <%= i <= Math.round(numericAvg) ? '#FFB703' : 'rgba(255,255,255,0.2)' %>;"></i>
                </span>
              <% } %>
              <span class="rating-num" style="margin-left: 6px;"><%= averageRating %></span>
              <span class="rating-max">/ 5 (<%= reviewCount %> review<%= reviewCount === 1 ? '' : 's' %>)</span>
            </div>
          </div>

          <div style="margin-top: 20px;">
            <%- include('../partials/favourite') %>
          </div>
        </div>
      </div>

      <!-- ── Booking Section ─────────────────────────────────────────── -->
      <% if (isLoggedIn && user && user.userType === 'guest') { %>
        <div class="booking-section">
          <div class="booking-card">
            <div class="booking-card-header">
              <h2><i class="fas fa-calendar-check"></i> Reserve This Stay</h2>
              <p class="booking-price-hint">₹<%= home.price %> / night</p>
            </div>

            <form action="/bookings" method="POST" class="booking-form" id="bookingForm">
              <input type="hidden" name="homeId" value="<%= home._id %>">

              <div class="booking-fields">
                <div class="booking-field-group">
                  <label for="checkIn"><i class="fas fa-sign-in-alt"></i> Check-in</label>
                  <input type="date" id="checkIn" name="checkIn" class="booking-input" required>
                </div>
                <div class="booking-field-group">
                  <label for="checkOut"><i class="fas fa-sign-out-alt"></i> Check-out</label>
                  <input type="date" id="checkOut" name="checkOut" class="booking-input" required>
                </div>
                <div class="booking-field-group">
                  <label for="guests"><i class="fas fa-users"></i> Guests</label>
                  <input type="number" id="guests" name="guests" class="booking-input" min="1" max="<%= home.maxGuests || 20 %>" value="1" required>
                </div>
              </div>

              <div class="booking-summary" id="bookingSummary" style="display:none;">
                <div class="summary-row">
                  <span>₹<%= home.price %> × <span id="nightsCount">0</span> night(s)</span>
                  <span id="nightsTotal">₹0</span>
                </div>
                <div class="summary-divider"></div>
                <div class="summary-row summary-total">
                  <strong>Total</strong>
                  <strong id="grandTotal">₹0</strong>
                </div>
              </div>

              <button type="submit" class="btn btn-primary booking-btn">
                <i class="fas fa-bolt"></i> Confirm Booking
              </button>
            </form>
          </div>
        </div>
      <% } else if (!isLoggedIn) { %>
        <div class="booking-section">
          <div class="booking-card booking-card-login">
            <i class="fas fa-lock booking-lock-icon"></i>
            <h3>Log in to Book</h3>
            <p>Sign in as a guest to reserve this property.</p>
            <a href="/login" class="btn btn-primary" style="margin-top:12px;">
              <i class="fas fa-sign-in-alt"></i> Log In
            </a>
          </div>
        </div>
      <% } %>

      <!-- ── Reviews Section ─────────────────────────────────────────── -->
      <section class="reviews-section">
        <div class="reviews-header">
          <div class="reviews-title-wrap">
            <h2><i class="fas fa-comments" style="color: var(--brand-pink);"></i> Guest Reviews</h2>
            <p class="section-subtext">Real feedback from guests who stayed here</p>
          </div>

          <div class="reviews-summary-badge">
            <div class="summary-badge-rating">
              <i class="fas fa-star" style="color: #FFB703;"></i>
              <span><%= averageRating %></span>
              <small>/ 5</small>
            </div>
            <div class="summary-badge-count">
              <%= reviewCount %> <%= reviewCount === 1 ? 'Review' : 'Reviews' %>
            </div>
          </div>
        </div>

        <!-- Write a Review Box -->
        <% if (isLoggedIn && !alreadyReviewed) { %>
          <div class="review-form-card">
            <div class="review-form-header">
              <h3><i class="fas fa-pen-fancy"></i> Leave a Review</h3>
              <p>Share your honest thoughts about the home and host</p>
            </div>

            <form action="/reviews/<%= home._id %>" method="POST" class="review-form">
              <div class="review-rating-select-wrap">
                <label for="rating"><i class="fas fa-star" style="color: #FFB703;"></i> Rating</label>
                <div class="rating-options">
                  <label class="rating-radio-label">
                    <input type="radio" name="rating" value="5" checked required>
                    <span>⭐⭐⭐⭐⭐ (5 - Excellent)</span>
                  </label>
                  <label class="rating-radio-label">
                    <input type="radio" name="rating" value="4">
                    <span>⭐⭐⭐⭐ (4 - Very Good)</span>
                  </label>
                  <label class="rating-radio-label">
                    <input type="radio" name="rating" value="3">
                    <span>⭐⭐⭐ (3 - Good)</span>
                  </label>
                  <label class="rating-radio-label">
                    <input type="radio" name="rating" value="2">
                    <span>⭐⭐ (2 - Fair)</span>
                  </label>
                  <label class="rating-radio-label">
                    <input type="radio" name="rating" value="1">
                    <span>⭐ (1 - Poor)</span>
                  </label>
                </div>
              </div>

              <div class="booking-field-group" style="margin-top: 14px;">
                <label for="comment"><i class="fas fa-comment-dots"></i> Your Experience</label>
                <textarea
                  name="comment"
                  id="comment"
                  class="review-textarea"
                  rows="4"
                  placeholder="How was your stay? How was the location, host, cleanliness?"
                  maxlength="500"
                  required
                ></textarea>
                <span class="review-char-count"><small id="charCount">0</small>/500 characters</span>
              </div>

              <button type="submit" class="btn btn-primary" style="margin-top: 12px; align-self: flex-start;">
                <i class="fas fa-paper-plane"></i> Submit Review
              </button>
            </form>
          </div>
        <% } else if (!isLoggedIn) { %>
          <div class="review-notice-card">
            <i class="fas fa-user-edit" style="font-size: 1.5rem; color: var(--brand-pink);"></i>
            <div>
              <p style="margin: 0; color: var(--text-primary); font-weight: 500;">Want to share your experience?</p>
              <p style="margin: 4px 0 0; color: var(--text-muted); font-size: 0.88rem;">
                Please <a href="/login" style="color: var(--brand-pink); text-decoration: underline; font-weight: 600;">log in</a> to write a review.
              </p>
            </div>
          </div>
        <% } else if (alreadyReviewed) { %>
          <div class="review-notice-card review-notice-checked">
            <i class="fas fa-check-circle" style="font-size: 1.5rem; color: #10B981;"></i>
            <div>
              <p style="margin: 0; color: var(--text-primary); font-weight: 600;">You've already reviewed this property</p>
              <p style="margin: 4px 0 0; color: var(--text-muted); font-size: 0.88rem;">
                Thank you for contributing your feedback to the community!
              </p>
            </div>
          </div>
        <% } %>

        <!-- Reviews List -->
        <div class="reviews-list-wrap">
          <% if (reviews && reviews.length > 0) { %>
            <div class="reviews-grid">
              <% reviews.forEach(function(review) { %>
                <div class="review-card">
                  <div class="review-card-top">
                    <div class="review-author-info">
                      <div class="review-avatar">
                        <%= review.userId && review.userId.firstName ? review.userId.firstName.charAt(0).toUpperCase() : 'G' %>
                      </div>
                      <div>
                        <h4 class="review-author-name">
                          <%= review.userId ? (review.userId.firstName + ' ' + (review.userId.lastName || '')) : 'Guest' %>
                        </h4>
                        <span class="review-date">
                          <i class="far fa-calendar-alt"></i> <%= new Date(review.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                        </span>
                      </div>
                    </div>

                    <div class="review-card-rating">
                      <% for (let s = 1; s <= 5; s++) { %>
                        <i class="fas fa-star" style="color: <%= s <= review.rating ? '#FFB703' : 'rgba(255,255,255,0.15)' %>;"></i>
                      <% } %>
                    </div>
                  </div>

                  <p class="review-text"><%= review.comment %></p>

                  <% if (user && review.userId && review.userId._id && review.userId._id.toString() === user._id.toString()) { %>
                    <div class="review-card-actions">
                      <form action="/reviews/delete/<%= review._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete your review?')">
                        <button type="submit" class="btn btn-danger-outline btn-sm">
                          <i class="fas fa-trash-alt"></i> Delete Review
                        </button>
                      </form>
                    </div>
                  <% } %>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="review-empty-state">
              <i class="far fa-comment-dots" style="font-size: 2.2rem; color: var(--text-dim); margin-bottom: 12px; display: block;"></i>
              <h3>No reviews yet</h3>
              <p>Be the first guest to stay and share your experience!</p>
            </div>
          <% } %>
        </div>
      </section>
    </main>

    <script>
      (function () {
        // Character counter for review textarea
        const commentArea = document.getElementById('comment');
        const charCount = document.getElementById('charCount');
        if (commentArea && charCount) {
          commentArea.addEventListener('input', function() {
            charCount.textContent = this.value.length;
          });
        }

        // Booking calculator
        const checkIn  = document.getElementById('checkIn');
        const checkOut = document.getElementById('checkOut');
        const guestsEl = document.getElementById('guests');
        const summary  = document.getElementById('bookingSummary');
        const nightsCount = document.getElementById('nightsCount');
        const nightsTotal = document.getElementById('nightsTotal');
        const grandTotal  = document.getElementById('grandTotal');
        const pricePerNight = <%= home.price %>;

        if (checkIn && checkOut) {
          const today = new Date().toISOString().split('T')[0];
          checkIn.min  = today;
          checkOut.min = today;

          function updateSummary() {
            const ci = new Date(checkIn.value);
            const co = new Date(checkOut.value);
            if (!checkIn.value || !checkOut.value || co <= ci) {
              summary.style.display = 'none';
              return;
            }
            const nights = Math.ceil((co - ci) / (1000 * 60 * 60 * 24));
            const total  = nights * pricePerNight;
            if (nightsCount) nightsCount.textContent = nights;
            if (nightsTotal) nightsTotal.textContent = '₹' + total.toLocaleString('en-IN');
            if (grandTotal) grandTotal.textContent  = '₹' + total.toLocaleString('en-IN');
            if (summary) summary.style.display = 'block';
          }

          checkIn.addEventListener('change', function () {
            if (checkOut.value && checkOut.value <= checkIn.value) {
              checkOut.value = '';
            }
            checkOut.min = checkIn.value;
            updateSummary();
          });

          checkOut.addEventListener('change', updateSummary);
          if (guestsEl) guestsEl.addEventListener('input', updateSummary);
        }
      })();
    </script>
  </body>
</html>

<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>

    <div class="search-filter-section">
      <form action="/" method="GET" class="smart-search-bar" role="search">
        <label class="search-segment" for="searchWhere">
          <span class="search-label">Where</span>
          <input
            type="search"
            id="searchWhere"
            name="where"
            class="search-value search-input"
            placeholder="Search destinations"
            value="<%= search.where %>"
          >
        </label>
        <div class="search-divider" aria-hidden="true"></div>
        <label class="search-segment" for="searchCheckIn">
          <span class="search-label">Check-in</span>
          <input type="date" id="searchCheckIn" name="checkIn" class="search-value search-input" value="<%= search.checkIn %>">
        </label>
        <div class="search-divider" aria-hidden="true"></div>
        <label class="search-segment" for="searchCheckOut">
          <span class="search-label">Check-out</span>
          <input type="date" id="searchCheckOut" name="checkOut" class="search-value search-input" value="<%= search.checkOut %>">
        </label>
        <div class="search-divider" aria-hidden="true"></div>
        <label class="search-segment" for="searchGuests">
          <span class="search-label">Guests</span>
          <input type="number" id="searchGuests" name="guests" class="search-value search-input" min="1" max="20" placeholder="Any guests" value="<%= search.guests %>">
        </label>
        <button type="submit" class="search-btn" aria-label="Search stays">
          <i class="fas fa-search"></i>
        </button>
      </form>

      <% if (searchError) { %>
        <p class="search-error" role="alert"><i class="fas fa-circle-exclamation"></i> <%= searchError %></p>
      <% } %>
      <% if (hasSearch) { %>
        <a href="/" class="search-clear">Clear search filters</a>
      <% } %>

     
    <main class="page-main">
      <div class="section-headline">
        <div>
          <h2><%= hasSearch ? "Search Results" : "Explore Places to Stay" %></h2>
          <p class="section-subtext">Verified spaces hosted by local hospitality experts</p>
        </div>
        <div class="results-count">
          <span><%= registeredHomes.length %> <%= registeredHomes.length === 1 ? 'property' : 'properties' %> available</span>
        </div>
      </div>

      <% if (registeredHomes.length > 0) { %>
        <div class="card-grid">
          <% registeredHomes.forEach(home => { %>
            <div class="card">
              <div class="card-image-wrapper">
                <img
                  src="<%= getPhotoUrl(home.photo) %>"
                  alt="<%= home.houseName || home.name || 'Property image' %>"
                  loading="lazy"
                >
                <div class="card-image-overlay"></div>
                
                <div class="card-glass-rating">
                  <i class="fas fa-star" style="color: #FFB703;"></i>
                  <span><%= home.rating ? home.rating : '4.8' %></span>
                </div>
                <% if (isLoggedIn && user && user.userType === 'guest') { %>
                  <form action="/favourites" method="POST" class="card-glass-fav-form">
                    <input type="hidden" name="id" value="<%= home._id %>">
                    <button type="submit" class="card-glass-fav-btn" title="Add to Favourites" aria-label="Add to favourites">
                      <i class="fas fa-heart"></i>
                    </button>
                  </form>
                <% } %>
              </div>

              <div class="card-body">
                <div class="card-header-row">
                  <h3 class="card-title"><%= home.houseName %></h3>
                </div>

                <p class="card-location">
                  <i class="fas fa-map-marker-alt"></i>
                  <%= home.location %>
                </p>

                <div class="card-footer">
                  <div class="card-price">
                    <span class="price-currency">₹</span>
                    <span class="price-amount"><%= Number(home.price).toLocaleString('en-IN') %></span>
                    <span class="price-period">/ night</span>
                  </div>

                  <a href="/homes/<%= home._id %>" class="btn btn-outline-primary btn-sm">
                    View Details
                  </a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-state-icon">
            <i class="fas fa-house-chimney"></i>
          </div>
          <h2><%= hasSearch ? "No Stays Match Your Search" : "No Properties Listed Yet" %></h2>
          <p><%= hasSearch ? "Try another destination, dates, or guest count." : "Check back soon or explore other destinations around the globe." %></p>
          <% if (hasSearch) { %>
            <a href="/" class="btn btn-outline-primary" style="margin-top: 18px;">Show all stays</a>
          <% } %>
          <% if (isLoggedIn && user && user.userType === 'host') { %>
            <a href="/host/add-home" class="btn btn-primary" style="margin-top: 18px;">
              <i class="fas fa-plus"></i> Add Your First Listing
            </a>
          <% } %>
        </div>
      <% } %>
    </main>
    <script>
      const checkInInput = document.getElementById("searchCheckIn");
      const checkOutInput = document.getElementById("searchCheckOut");
      const today = new Date().toISOString().slice(0, 10);
      checkInInput.min = today;
      checkOutInput.min = checkInInput.value || today;
      checkInInput.addEventListener("change", function () {
        checkOutInput.min = checkInInput.value || today;
        if (checkOutInput.value && checkOutInput.value <= checkInInput.value) {
          checkOutInput.value = "";
        }
      });
    </script>
  </body>
</html>

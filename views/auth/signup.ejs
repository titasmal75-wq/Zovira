<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>

    <main class="page-main">
      <div class="form-container">
        <div class="form-header">
          <h1>Create Your Account</h1>
          <p>Join the community and start exploring</p>
        </div>

        <form action="/signup" method="POST">
          <%- include('../partials/errors') %>

          <!-- Name Fields -->
          <div class="form-row">
            <div class="form-group">
              <label for="firstName" class="form-label">First Name</label>
              <div class="form-input-wrapper">
                <input
                  type="text"
                  id="firstName"
                  name="firstName"
                  placeholder="John"
                  value="<%= oldInput.firstName ? oldInput.firstName : '' %>"
                  class="form-input"
                  required
                />
                <i class="fas fa-user form-input-icon"></i>
              </div>
            </div>

            <div class="form-group">
              <label for="lastName" class="form-label">Last Name</label>
              <div class="form-input-wrapper">
                <input
                  type="text"
                  id="lastName"
                  name="lastName"
                  placeholder="Doe"
                  value="<%= oldInput.lastName ? oldInput.lastName : '' %>"
                  class="form-input"
                />
                <i class="fas fa-user form-input-icon"></i>
              </div>
            </div>
          </div>

          <!-- Email -->
          <div class="form-group">
            <label for="email" class="form-label">Email Address</label>
            <div class="form-input-wrapper">
              <input
                type="email"
                id="email"
                name="email"
                placeholder="your.email@example.com"
                value="<%= oldInput.email ? oldInput.email : '' %>"
                class="form-input"
                required
              />
              <i class="fas fa-envelope form-input-icon"></i>
            </div>
          </div>

          <!-- Password -->
          <div class="form-group">
            <label for="password" class="form-label">Password</label>
            <div class="form-input-wrapper">
              <input
                type="password"
                id="password"
                name="password"
                placeholder="Min. 8 characters"
                class="form-input"
                required
              />
              <i class="fas fa-lock form-input-icon"></i>
            </div>
          </div>

          <!-- Confirm Password -->
          <div class="form-group">
            <label for="confirmPassword" class="form-label">Confirm Password</label>
            <div class="form-input-wrapper">
              <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                placeholder="Re-enter your password"
                class="form-input"
                required
              />
              <i class="fas fa-shield-alt form-input-icon"></i>
            </div>
          </div>

          <!-- User Type -->
          <div class="form-group">
            <div class="form-radio-group">
              <p>I want to register as:</p>
              <div class="form-radio-options">
                <label class="form-radio-label">
                  <input type="radio" name="userType" value="guest" <%= oldInput.userType === 'guest' ? 'checked' : '' %> />
                  <i class="fas fa-suitcase-rolling" style="color: var(--brand-pink);"></i>
                  Guest
                </label>
                <label class="form-radio-label">
                  <input type="radio" name="userType" value="host" <%= oldInput.userType === 'host' ? 'checked' : '' %> />
                  <i class="fas fa-key" style="color: var(--brand-red);"></i>
                  Host
                </label>
              </div>
            </div>
          </div>

          <!-- Terms -->
          <div class="form-group">
            <label class="form-checkbox-label">
              <input type="checkbox" name="terms" required />
              I agree to the <a href="#">Terms & Conditions</a>
            </label>
          </div>

          <!-- Submit -->
          <button type="submit" class="form-submit">
            <span>Create Account</span>
            <i class="fas fa-arrow-right"></i>
          </button>

          <div class="form-footer">
            Already have an account? <a href="/login">Sign in</a>
          </div>
        </form>
      </div>
    </main>
  </body>
</html>